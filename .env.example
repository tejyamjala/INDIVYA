# Browser-visible Supabase project URL.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Preferred: public Supabase publishable key (safe to expose only with correct RLS).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy alternative: use this instead if your project still has an anon JWT key.
# VITE_SUPABASE_ANON_KEY=
